{
  "manifest_version": 3,
  "name": "Decathlon Canada -> TR Price Compare",
  "version": "1.1.0",
  "description": "Decathlon Canada listeleme sayfalarında TR fiyatını ve daha ucuz/pahalı bilgisini gösterir.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.decathlon.ca/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.decathlon.ca/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
