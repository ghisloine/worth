{
  "manifest_version": 3,
  "name": "Decathlon CA -> TR Price Compare",
  "version": "2.0.0",
  "description": "Decathlon Canada listeleme ve ürün sayfalarında, aynı ref id'ye sahip ürünün Türkiye fiyatını gösterir.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.decathlon.ca/*",
    "https://www.decathlon.com.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.decathlon.ca/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
